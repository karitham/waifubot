{
  "name": "waifubot-frontend",
  "version": "0.0.0",
  "description": "Web interface for browsing waifubot character collections and wishlists",
  "homepage": "https://waifugui.karitham.dev",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "generate:api": "oazapfts ../openapi.yaml --optimistic --useEnumType --optimistic --futureStripLegacyMethods > ./src/api/generated.ts"
  },
  "dependencies": {
    "@kobalte/core": "2.0.0-alpha.4",
    "@oazapfts/runtime": "^1.2.0",
    "@solidjs/web": "^2.0.3",
    "@tanstack/virtual-core": "3.13.23",
    "dompurify": "^3.3.3",
    "marked": "^15.0.12",
    "oazapfts": "^7.4.0",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@iconify-json/ph": "^1.2.2",
    "@solidjs/router": "^2.0.0",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^25.3.3",
    "@unocss/preset-icons": "^66.5.10",
    "@unocss/preset-wind4": "^66.5.10",
    "@unocss/vite": "^66.5.10",
    "jsdom": "^29.1.0",
    "typescript": "^5.8.3",
    "unocss": "^66.5.10",
    "vite": "^8.0.0",
    "vitest": "^4.0.0"
  }
}
